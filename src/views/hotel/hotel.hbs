<div class="container-fluid mt-5 ">
    <h2>Descubre nuestros alojamientos</h2>
    <div class="row row-cols-1 row-cols-md-3 g-4">
     
      {{#if items}}
        {{#each items}}
         <div class="col">
          {{> card}}
          </div>
        {{/each}}
      {{else}}
        <p>No hay hoteles para mostrar.</p>
      {{/if}}
    </div>