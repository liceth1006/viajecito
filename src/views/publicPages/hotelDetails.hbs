</script>
<div class="container mt-4">
  <div class="row mb-5">
    <div class="col-md-8">
      <h3 class="card-text">{{details.name}}</h3>
      <p class="card-title">
        <i class="fa-solid fa-location-dot text-primary"></i>
        {{details.address}}
      </p>
    </div>
    <div class="d-grid col-6 col-md-4">
      <button type="submit" class="button">
        <span>
          <i class="fa-solid fa-magnifying-glass mx-2"></i>Reservar
        </span>
      </button>
    </div>
  </div>
  <div class="lightbox">
    <div class="row">
      <!-- Left Section: Images -->
      <div class="col-lg-9">
        <div class="row">
          <!-- First Column of Images -->
          <div class="col-lg-6">
            <img src="{{photos1.url_max}}" alt="Imagen del hotel 1" class="w-100 mb-2 mb-md-4 shadow-1-strong rounded"
              style="height: 250px;" />
            <img src="{{photos2.url_max}}" alt="Imagen del hotel 2" class="w-100 shadow-1-strong rounded"
              style="height: 250px;" />
          </div>
          <!-- Second Column of Images -->
          <div class="col-lg-6">
            <img src="{{photos3.url_max}}" alt="Imagen del hotel 3" class="w-100 shadow-1-strong rounded"
              style="height: 500px;" />
          </div>
        </div>
      </div>
      <!-- Right Section: Reservation -->
      <div class="col-lg-3">
        <div class="reservation-box shadow-1-strong rounded p-3">
          <!-- Reservation content goes here -->
          <h4>Reserva</h4>
          <p>Detalles de la reserva...</p>
          <!-- You can add a form, button, or any other content here -->
        </div>
      </div>
    </div>
  </div>
  <div class="col-12 mt-3">
    <!-- Mostrar la descripción en español -->
    <p>{{descriptionSpanish}}</p>
  </div>
  <div class="col-12 mt-3"></div>
  <!-- Mostrar la descripción en español -->
  {{!-- <p>{{details.location.latitude}}</p>
  <p>{{details.location.longitude}}</p> --}}
  <iframe width="100%" height="500px" style="border:0" loading="lazy" allowfullscreen
    referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps/embed/v1/place?key=AIzaSyBI5jgmZQB_p68Qge2QgLOaQ-m3mjXJOZk&q={{details.name}}">
  </iframe>
</div>