<main>
  {{>carousel}}
  <div class="position">
  {{>search}}
  </div>
  <div class="container-fluid mt-5 ">
    <h2>Descubre Colombia</h2>
    <p>Estos destinos populares tienen mucho que ofrecer</p>
    <div class="row row-cols-1 row-cols-md-3 g-4">
     
      {{#if items}}
        {{#each items}}
         <div class="col">
          {{> cardSearchDestination}}
          </div>
        {{/each}}
      {{else}}
        <p>No hay hoteles para mostrar.</p>
      {{/if}}
    </div>
 
  </div>
</main>
