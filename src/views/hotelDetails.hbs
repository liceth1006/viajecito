<div class="container mt-4">
  <div class="row mb-5">
    <div class="col-md-8">
      <h3 class="card-text">{{details.name}}</h3>
      <p class="card-title">
        <i class="fa-solid fa-location-dot text-primary"></i>
        {{details.address}}
      </p>
    </div>
    <div class="col-md-4 d-grid">
      <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#reservationModal">
        <i class="fa-solid fa-magnifying-glass mx-2"></i>Reservar
      </button>
    </div>
  </div>
  
  <div class="lightbox">
    <div class="row">
      <div class="col-lg-9">
        <div class="row">
          <div class="col-lg-6">
            <img src="{{photos1.url_max}}" alt="Imagen del hotel 1" class="w-100 mb-2 shadow-1-strong rounded" style="height: 250px;" />
            <img src="{{photos2.url_max}}" alt="Imagen del hotel 2" class="w-100 shadow-1-strong rounded" style="height: 250px;" />
          </div>
          <div class="col-lg-6">
            <img src="{{photos3.url_max}}" alt="Imagen del hotel 3" class="w-100 shadow-1-strong rounded" style="height: 500px;" />
          </div>
        </div>
      </div>
      <div class="col-lg-3 h-100">
        {{>carouselOption}}
      </div>
    </div>
  </div>
  
  <div class="col-12 mt-3">
    <p>{{descriptionSpanish}}</p>
  </div>
  
  <div class="col-12 mt-3">
    <iframe width="100%" height="500px" style="border:0;" loading="lazy" allowfullscreen
      referrerpolicy="no-referrer-when-downgrade" 
      src="https://www.google.com/maps/embed/v1/place?key=AIzaSyBI5jgmZQB_p68Qge2QgLOaQ-m3mjXJOZk&q={{details.name}}">
    </iframe>
  </div>
  
  <!-- Modal -->
  <div class="modal fade" id="reservationModal" tabindex="-1" aria-labelledby="reservationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="reservationModalLabel">Reservas</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="reservationForm" onsubmit="registerReservation(event)">
            <p id="">Nombre: {{details.name}}</p>
            <p id="property_id">Direccion: {{details.address}}</p>
            <div class="row">
              <div class="mb-3 col-md-6">
                <label for="check_in_date" class="form-label">Fecha de Llegada</label>
                <input
                  type="date"
                  class="form-control"
                  id="check_in_date"
                  name="check_in_date"
                  required/>
              </div>
              <div class="mb-3 col-md-6">
                <label for="check_out_date" class="form-label">Fecha de Salida</label>
                <input
                  type="date"
                  class="form-control"
                  id="check_out_date"
                  name="check_out_date"
                  required/>
              </div>
            </div>
            <div class="d-grid">
              <button type="submit" class="btn btn-primary">Reservar</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>