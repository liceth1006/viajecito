<div class="container p-4">
  <div class="row">
    <div class="col-md-4 mx-auto">
      <div class="card text-center">
        <div class="card-header">
          <h3 class="text-uppercase"> CREAR NUEVA PERSONA</h3>
        </div>
        <div class="card-body">
          <form action="/add" method="post">
            <div class="input-group mt-2">
              <label for="name" class="input-group-text">Nombre</label>
              <input
                class="form-control"
                type="text"
                name="name"
                id="name"
                placeholder="Ejemplo: Luis Angel"
                autofocus
                required
              />
            </div>
            <div class="input-group mt-2">
              <label for="lastname" class="input-group-text">Apellido</label>
              <input
                class="form-control"
                type="text"
                name="lastname"
                id="lastname"
                placeholder="Ejemplo: Fernandez"
                required
              />
            </div>
            <div class="input-group mt-2">
              <label for="age" class="input-group-text">Edad</label>
              <input
                class="form-control"
                type="number"
                name="age"
                id="age"
                placeholder="20"
                required
              />
            </div>
            <div class="input-group mt-2">
              <label for="tipo_persona_id" class="input-group-text">Tipo de persona</label>
              <select
                class="form-select form-select-lg"
                name="tipo_persona_id"
                id="tipo_persona_id"
                required
              >
                <option value="" disabled selected>Seleccione uno</option>
                {{#each tipo_persona}}
                  <option value="{{id}}">{{tipo}}</option>
                {{/each}}
              </select>
            </div>
            <div class="form-group mt-4 d-grid gap-2">
              <button class="btn " style="background-color: #FFC300;"> Crear</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>




