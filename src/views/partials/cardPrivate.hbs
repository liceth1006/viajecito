<div class="card h-100">
  <div class="image-container">
    <img
      src="{{max_photo_url}}"
      class="card-img-top"
      alt="{{hotel_name_trans}}"
    />
  </div>
  <div class="card-body">
    <h4 class="card-title">{{hotel_name_trans}}</h4>
    <p class="text-md-end text-success">
      <i class="fa-solid fa-ranking-star"></i>
      {{review_score_word}} ({{review_score}})
    </p>
    <div class="row">
      <div class="col-4">
        <p><i class="fa-solid fa-tree-city text-success"></i> {{city}}</p>
      </div>
      <div class="col-8">
        <p><i class="fa-solid fa-location-dot text-primary"></i> {{address}}</p>
      </div>
    </div>
    <h4>Precio por noche: {{composite_price_breakdown.gross_amount_per_night.amount_unrounded}}</h4>
    <h4>Precio Total: {{composite_price_breakdown.all_inclusive_amount.amount_rounded}}</h4>
    <p class="card-text mb-0">{{ribbon_text}}</p>
    <p class="card-text mb-0">Cancelación gratuita:
      {{#if is_free_cancellable}}
        <span class="text-success mb-0">Sí</span>
      {{else}}
        <span class="text-danger mb-0">No</span>
      {{/if}}
    </p>
    <p class="card-text mb-0">Pago por adelantado:
      {{#if cc_required}}
        <span class="text-success">Requerido</span>
      {{else}}
        <span class="text-danger">No requerido</span>
      {{/if}}
    </p>
    <p class="card-text mb-0">Check-in: desde {{checkin.from}} hasta {{checkin.until}}</p>
    <p class="card-text mb-0">Check-out: desde {{checkout.from}} hasta {{checkout.until}}</p>
    <div class="d-grid gap-2 col-6 mx-auto mt-2">
      <a href="/hotelDetails/{{hotel_id}}" class="button">
        <span>Ver disponibilidad <i class="fa-solid fa-chevron-right"></i></span>
      </a>
    </div>
    <div class="position-absolute top-0 end-0 p-3">
      {{#if badges}}
        {{#each badges}}
          <span class="badge bg-success mb-0">{{text}}</span>
        {{/each}}
      {{/if}}
    </div>
  </div>

<!-- Botón de favorito -->
<div id="{{hotel_id}}" class="favorite" onclick="postFavorite('{{hotel_id}}', '{{hotel_name_trans}}', '{{max_photo_url}}', '{{review_score_word}}', {{review_score}}, '{{city}}', '{{address}}', {{gross_amount_per_night}})">
  <img id="img-{{hotel_id}}" src="../img/iconNoFavorito.png" alt="Añadir a favoritos" />
</div>

</div>

