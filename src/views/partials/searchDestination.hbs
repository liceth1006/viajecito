<div class="container-fluid search">
  <form id="Form" >
    <div class="row py-2 align-items-center">
      <div class="col-md-8 mb-3 mb-md-0">
        <label for="destination" class="form-label">Buscar destino</label>
        <input
          type="text"
          class="form-control"
          id="destination"
          name="destination"
          placeholder="Ingrese el destino"
        />
      </div>
      <div class="col-md-4 d-grid">
        <button type="submit" class="btn btn-primary">
          <span><i class="fa-solid fa-magnifying-glass mx-2"></i>Buscar</span>
        </button>
      </div>
    </div>
  </form>
</div>
