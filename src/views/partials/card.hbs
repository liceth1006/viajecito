<div class="card h-100">
  <div class="image-container">
    <img src="{{photoMainUrl}}" class="card-img-top" alt="{{name}}" />
  </div>
  <div class="card-body">
    <h5 class="card-title">{{name}}</h5>
    <p class="card-text">{{priceBreakdown.strikethroughPrice.value}}</p>
     <a href="/hoteldetails/{{id}}" class="btn btn-primary">Comparar Precios</a> 
  </div>
  {{>favorite}}
</div>