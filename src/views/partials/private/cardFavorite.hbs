<div class="col">
  <div class="card mb-3 h-100" style="max-width: 540px;">
    <div class="row g-0">
      <div class="col-md-4">
        <img
          src="{{max_photo_url}}"
          class="img-fluid rounded-start"
          alt="Imagen del hotel {{hotel_name_trans}}"
        />
      </div>
      <div class="col-md-8">
        <div class="card-body">
          <h5 class="card-title">{{hotel_name_trans}}</h5>
          <p class="text-md-end text-success">
            <i class="fa-solid fa-ranking-star"></i>
            {{review_score_word}} ({{review_score}})
          </p>
          <div class="row">
            <div class="col-4">
              <p><i class="fa-solid fa-tree-city text-success"></i> {{city}}</p>
            </div>
            <div class="col-8">
              <p><i class="fa-solid fa-location-dot text-primary"></i> {{address}}</p>
            </div>
          </div>
          <h5>Precio por noche: {{amount_unrounded}}</h5>
        </div>
      </div>
    </div>

    <!-- Icono de favorito corregido -->
    <div class="position-absolute top-0 end-0 p-5 ">
      <a class="favorite" href="/favoritePublic">
       <i class="fa-solid fa-trash-can fs-3 text-danger"></i>
      </a>
    </div>
  </div>
</div>
